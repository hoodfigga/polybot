# ==============================================================================
# POLYBOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Network & RPC
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Polymarket Wallet & Authentication
# Your Polygon EOA Private Key (Hex without 0x prefix or with 0x prefix)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Polymarket Proxy / Fund Address (e.g., Magic / Gnosis Safe proxy address)
POLYMARKET_PROXY_ADDRESS=0x0000000000000000000000000000000000000000

# Polymarket Level-2 CLOB API Credentials (Optional - can be derived via generate_polymarket_credentials)
POLY_API_KEY=your_polymarket_api_key
POLY_SECRET=your_polymarket_api_secret_base64
POLY_PASSPHRASE=your_polymarket_api_passphrase

# Trading Mode (true = live real capital, false = dry-run / paper simulation)
LIVE_TRADING=false

# Node Configuration
PORT=9005
RUST_LOG=info,trading_node=debug
